<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>YKS Çoklu Blok Günlük Takip Sistemi</title>
    <style>
        :root {
            --bg-color: #0f172a;
            --card-bg: #1e293b;
            --accent-tyt: #3b82f6;
            --accent-ayt: #8b5cf6;
            --text-main: #f8fafc;
            --text-sub: #94a3b8;
            --border-color: #334155;
            --success: #22c55e;
            --warning: #f59e0b;
            --danger: #ef4444;
        }

        * { box-sizing: border-box; margin: 0; padding: 0; font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; }
        body { background-color: var(--bg-color); color: var(--text-main); padding: 20px; min-height: 100vh; }

        .auth-overlay { position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: var(--bg-color); display: flex; justify-content: center; align-items: center; z-index: 1000; }
        .auth-card { background: var(--card-bg); padding: 30px; border-radius: 12px; border: 1px solid var(--border-color); width: 90%; max-width: 400px; text-align: center; }
        .auth-card h2 { color: var(--accent-tyt); margin-bottom: 10px; }
        .auth-card p { color: var(--text-sub); font-size: 0.9rem; margin-bottom: 20px; }

        .container { max-width: 1200px; margin: 0 auto; display: none; }
        header { display: flex; justify-content: space-between; align-items: center; background: var(--card-bg); padding: 20px; border-radius: 12px; border: 1px solid var(--border-color); margin-bottom: 20px; flex-wrap: wrap; gap: 10px; }

        .tabs { display: flex; gap: 8px; margin-bottom: 20px; overflow-x: auto; padding-bottom: 5px; }
        .tab-btn { background: var(--card-bg); color: var(--text-sub); border: 1px solid var(--border-color); padding: 10px 15px; border-radius: 8px; cursor: pointer; font-weight: 600; white-space: nowrap; }
        .tab-btn.active { background: var(--accent-tyt); color: white; border-color: var(--accent-tyt); }

        .sub-tabs { display: flex; gap: 6px; margin-bottom: 15px; overflow-x: auto; padding-bottom: 5px; }
        .sub-tab-btn { background: #0f172a; color: var(--text-sub); border: 1px solid var(--border-color); padding: 8px 12px; border-radius: 6px; cursor: pointer; font-size: 0.85rem; font-weight: 600; white-space: nowrap; }
        .sub-tab-btn.active { background: var(--warning); color: #0f172a; border-color: var(--warning); }

        .tab-content { display: none; }
        .tab-content.active { display: block; }
        .sub-tab-content { display: none; }
        .sub-tab-content.active { display: block; }

        .card { background: var(--card-bg); border-radius: 12px; padding: 20px; border: 1px solid var(--border-color); margin-bottom: 15px; }

        input[type="text"], input[type="number"], select { width: 100%; padding: 10px; background: #0f172a; border: 1px solid var(--border-color); border-radius: 6px; color: var(--text-main); margin-top: 5px; }
        .btn { background: var(--accent-tyt); color: white; border: none; padding: 10px 20px; border-radius: 6px; cursor: pointer; font-weight: 600; width: 100%; margin-top: 10px; }
        .btn-danger { background: var(--danger); width: auto; }
        .btn-secondary { background: var(--border-color); width: auto; }

        .day-card { background: #0f172a; border: 1px solid var(--border-color); padding: 15px; border-radius: 10px; margin-bottom: 15px; }
        .rest-card { border-left: 6px solid var(--success); }
        .study-card { border-left: 6px solid var(--accent-tyt); }

        .block-list { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 10px; margin-top: 10px; }
        .block-item { background: #1e293b; padding: 12px; border-radius: 6px; border: 1px solid #334155; display: flex; align-items: flex-start; gap: 12px; transition: border-color 0.2s; }
        .block-item.completed { border-color: var(--success); opacity: 0.8; }
        .block-item.completed .block-title { text-decoration: line-through; color: var(--text-sub); }

        .block-checkbox { width: 20px; height: 20px; accent-color: var(--success); cursor: pointer; margin-top: 2px; }

        .block-tag { font-size: 0.75rem; padding: 2px 6px; border-radius: 4px; font-weight: bold; background: rgba(59, 130, 246, 0.2); color: #60a5fa; margin-bottom: 4px; display: inline-block; }

        .timer-display { font-size: 3rem; font-weight: bold; text-align: center; font-family: monospace; margin: 20px 0; color: #38bdf8; }
    </style>
</head>
<body>

    <!-- GİRİŞ EKRANI -->
    <div id="auth-screen" class="auth-overlay">
        <div class="auth-card">
            <h2>YKS Akademi Giriş</h2>
            <p>Seni tanımamız ve verilerini saklamamız için adını gir.</p>
            <input type="text" id="username-input" placeholder="Adınız Soyadınız">
            <button class="btn" onclick="login()">Sisteme Giriş Yap</button>
        </div>
    </div>

    <!-- ANA UYGULAMA -->
    <div id="app-screen" class="container">
        <header>
            <div>
                <h1>Hoş geldin, <span id="user-display-name" style="color: var(--accent-tyt);"></span>!</h1>
                <p style="color: var(--text-sub); font-size: 0.85rem;">Maksimum 12 Saatlik Çoklu Blok Programı (10 Kasım 2026 Başlangıç)</p>
            </div>
            <button class="btn btn-danger" onclick="logout()">Oturumu Kapat</button>
        </header>

        <div class="tabs">
            <button class="tab-btn active" onclick="switchTab(event, 'tab-calendar')">Çoklu Blok Günlük Takvim</button>
            <button class="tab-btn" onclick="switchTab(event, 'tab-timer')">Çalışma Bloğu (90+15)</button>
            <button class="tab-btn" onclick="switchTab(event, 'tab-analysis')">Deneme Analizleri</button>
        </div>

        <!-- 1. GÜNLÜK TAKVİM (ÇOKLU BLOKLU + TAMAMLANDI KUTUCUKLU) -->
        <div id="tab-calendar" class="tab-content active">
            <div class="card">
                <h2>Günlük Maksimum 12 Saatlik Çoklu Çalışma Blokları</h2>
                <p style="font-size: 0.85rem; color: var(--text-sub); margin-bottom: 15px;">Tamamladığın derslerin kutucuklarını işaretle. İşaretlerin kalıcı olarak saklanır.</p>
                
                <div class="sub-tabs">
                    <button class="sub-tab-btn active" onclick="switchSubTab(event, 'sub-kasim')">Kasım 2026</button>
                    <button class="sub-tab-btn" onclick="switchSubTab(event, 'sub-aralik')">Aralık 2026</button>
                    <button class="sub-tab-btn" onclick="switchSubTab(event, 'sub-ocak')">Ocak 2027</button>
                    <button class="sub-tab-btn" onclick="switchSubTab(event, 'sub-subat')">Şubat 2027</button>
                    <button class="sub-tab-btn" onclick="switchSubTab(event, 'sub-mart')">Mart 2027</button>
                    <button class="sub-tab-btn" onclick="switchSubTab(event, 'sub-nisan')">Nisan 2027</button>
                    <button class="sub-tab-btn" onclick="switchSubTab(event, 'sub-mayis')">Mayıs 2027</button>
                </div>

                <div id="sub-kasim" class="sub-tab-content active"><div id="list-kasim"></div></div>
                <div id="sub-aralik" class="sub-tab-content"><div id="list-aralik"></div></div>
                <div id="sub-ocak" class="sub-tab-content"><div id="list-ocak"></div></div>
                <div id="sub-subat" class="sub-tab-content"><div id="list-subat"></div></div>
                <div id="sub-mart" class="sub-tab-content"><div id="list-mart"></div></div>
                <div id="sub-nisan" class="sub-tab-content"><div id="list-nisan"></div></div>
                <div id="sub-mayis" class="sub-tab-content"><div id="list-mayis"></div></div>
            </div>
        </div>

        <!-- 2. ZAMANLAYICI -->
        <div id="tab-timer" class="tab-content">
            <div class="card" style="text-align: center; max-width: 500px; margin: 0 auto;">
                <h2 id="timer-title">Odaklanma Bloğu (90 Dakika)</h2>
                <div class="timer-display" id="timer-display">90:00</div>
                <div style="display: flex; gap: 10px; justify-content: center;">
                    <button class="btn" style="width: auto;" onclick="toggleTimer()" id="timer-btn">Başlat</button>
                    <button class="btn btn-secondary" style="width: auto;" onclick="resetTimer()">Sıfırla</button>
                </div>
            </div>
        </div>

        <!-- 3. DENEME ANALİZLERİ -->
        <div id="tab-analysis" class="tab-content">
            <div class="card">
                <h2>Deneme Netleri & Kök Neden Analizi</h2>
                <div style="margin-bottom: 15px;">
                    <label>Deneme Türü</label>
                    <select id="exam-type">
                        <option value="TYT">TYT Deneme</option>
                        <option value="AYT">AYT Deneme</option>
                    </select>
                    
                    <label style="margin-top: 10px; display: block;">Net Sayısı</label>
                    <input type="number" id="exam-net" step="0.25" placeholder="Örn: 75.00">

                    <label style="margin-top: 10px; display: block;">Hata Kök Nedeni</label>
                    <select id="exam-reason">
                        <option value="Konu / Bilgi Eksikliği">Konu / Bilgi Eksikliği</option>
                        <option value="Dikkatsizlik / İşlem Hatası">Dikkatsizlik / İşlem Hatası</option>
                        <option value="Süre Yetiştirememe">Süre Yetiştirememe</option>
                    </select>

                    <button class="btn" onclick="saveAnalysis()">Analizi Kaydet</button>
                </div>

                <h3>Geçmiş Analiz Kayıtları</h3>
                <div id="analysis-list" style="margin-top: 10px;"></div>
            </div>
        </div>
    </div>

<script>
    const tytPool = [
        { desc: "TYT Matematik - Temel Kavramlar & Sayılar", time: 3 },
        { desc: "TYT Fizik - Fizik Bilimine Giriş & Madde Özellikleri", time: 2.5 },
        { desc: "TYT Kimya - Kimya Bilimi & Periyodik Cetvel", time: 2.5 },
        { desc: "TYT Türkçe / Paragraf Rutini & Dil Bilgisi", time: 2 },
        { desc: "TYT Matematik - Bölme Bölünebilme & EBOB EKOK", time: 3 },
        { desc: "TYT Matematik - Rasyonel Sayılar & Basit Eşitsizlikler", time: 3 },
        { desc: "TYT Fizik - Basınç ve Sıvıların Kaldırma Kuvveti", time: 2.5 },
        { desc: "TYT Kimya - Kimyasal Türler Arası Etkileşimler", time: 2.5 },
        { desc: "TYT Matematik - Mutlak Değer & Üslü İfadeler", time: 3 },
        { desc: "TYT Matematik - Köklü İfadeler & Çarpanlara Ayırma", time: 3 },
        { desc: "TYT Matematik - Sayı ve Kesir Problemleri", time: 4 },
        { desc: "TYT Fizik - Isı, Sıcaklık ve Genleşme", time: 2.5 },
        { desc: "TYT Kimya - Maddenin Halleri ve Doğa", time: 2.5 },
        { desc: "TYT Matematik - Yaş ve Hareket Problemleri", time: 3 },
        { desc: "TYT Matematik - Yüzde, Kar-Zarar ve Karışım Problemleri", time: 3.5 },
        { desc: "TYT Fizik - Hareket ve Newton Yasaları", time: 3 },
        { desc: "TYT Kimya - Kimyanın Temel Kanunları", time: 2.5 },
        { desc: "TYT Matematik - Kümeler, Mantık ve Fonksiyonlar", time: 3.5 },
        { desc: "TYT Fizik - İş, Güç, Enerji & Optik", time: 3.5 },
        { desc: "TYT Kimya - Asitler, Bazlar ve Karışımlar", time: 2.5 }
    ];

    const aytPool = [
        { desc: "AYT Matematik - 2. Dereceden Denklemler & Parabol", time: 3.5 },
        { desc: "AYT Fizik - Vektörler & Bağıl Hareket", time: 3 },
        { desc: "AYT Kimya - Modern Atom Teorisi & Gazlar", time: 3.5 },
        { desc: "AYT Matematik - Trigonometri Derinleşme Kampı", time: 4 },
        { desc: "AYT Matematik - Logaritma ve Diziler", time: 3.5 },
        { desc: "AYT Fizik - Newton Yasaları & Atışlar", time: 3 },
        { desc: "AYT Kimya - Sıvı Çözeltiler & Enerji", time: 3 },
        { desc: "AYT Matematik - Limit ve Süreklilik", time: 3.5 },
        { desc: "AYT Matematik - Türev ve Uygulamaları", time: 4.5 },
        { desc: "AYT Fizik - İtme, Momentum & Tork", time: 3 },
        { desc: "AYT Kimya - Tepkime Hızları & Kimyasal Denge", time: 3.5 },
        { desc: "AYT Matematik - İntegral ve Alan Hesabı", time: 4.5 },
        { desc: "AYT Fizik - Çembersel Hareket & Harmonik Hareket", time: 3.5 },
        { desc: "AYT Kimya - Elektrokimya & Organik Kimya", time: 4 }
    ];

    let currentUser = localStorage.getItem('yks_multiblock_username') || '';
    let analyses = JSON.parse(localStorage.getItem('yks_multiblock_analyses')) || [];
    let completedBlocks = JSON.parse(localStorage.getItem('yks_completed_blocks')) || [];

    window.onload = function() {
        if (currentUser) showApp();
        generateMultiBlockSchedule();
    };

    function login() {
        const input = document.getElementById('username-input').value.trim();
        if (!input) return;
        currentUser = input;
        localStorage.setItem('yks_multiblock_username', currentUser);
        showApp();
    }

    function logout() {
        if (confirm("Çıkış yapmak istediğine emin misin?")) {
            localStorage.removeItem('yks_multiblock_username');
            location.reload();
        }
    }

    function showApp() {
        document.getElementById('auth-screen').style.display = 'none';
        document.getElementById('app-screen').style.display = 'block';
        document.getElementById('user-display-name').innerText = currentUser;
        renderAnalyses();
    }

    function toggleBlockCompletion(blockId) {
        if (completedBlocks.includes(blockId)) {
            completedBlocks = completedBlocks.filter(id => id !== blockId);
        } else {
            completedBlocks.push(blockId);
        }
        localStorage.setItem('yks_completed_blocks', JSON.stringify(completedBlocks));
        
        const el = document.getElementById(`block-item-${blockId}`);
        if (el) {
            if (completedBlocks.includes(blockId)) {
                el.classList.add('completed');
            } else {
                el.classList.remove('completed');
            }
        }
    }

    function generateMultiBlockSchedule() {
        let tIndex = 0;
        let aIndex = 0;

        const months = [
            { id: 'kasim', name: 'Kasım 2026', startDay: 10, totalDays: 30, phase: 'TYT' },
            { id: 'aralik', name: 'Aralık 2026', startDay: 1, totalDays: 31, phase: 'TYT' },
            { id: 'ocak', name: 'Ocak 2027', startDay: 1, totalDays: 31, phase: 'TYT' },
            { id: 'subat', name: 'Şubat 2027', startDay: 1, totalDays: 28, phase: 'AYT' },
            { id: 'mart', name: 'Mart 2027', startDay: 1, totalDays: 31, phase: 'AYT' },
            { id: 'nisan', name: 'Nisan 2027', startDay: 1, totalDays: 30, phase: 'AYT' },
            { id: 'mayis', name: 'Mayıs 2027', startDay: 1, totalDays: 31, phase: 'GENEL TEKRAR' }
        ];

        let globalDayCount = 0;

        months.forEach(m => {
            const container = document.getElementById(`list-${m.id}`);
            let html = '';

            for (let day = m.startDay; day <= m.totalDays; day++) {
                globalDayCount++;
                const isRest = (globalDayCount % 7 === 0);
                const dayKey = `${m.id}-${day}`;

                if (isRest) {
                    const blockId = `${dayKey}-rest`;
                    const isChecked = completedBlocks.includes(blockId);
                    html += `
                        <div class="day-card rest-card">
                            <div class="block-item ${isChecked ? 'completed' : ''}" id="block-item-${blockId}">
                                <input type="checkbox" class="block-checkbox" ${isChecked ? 'checked' : ''} onchange="toggleBlockCompletion('${blockId}')">
                                <div>
                                    <h3 class="block-title">${day} ${m.name} - 7. GÜN: DİNLENME & GENEL TEKRAR</h3>
                                    <p style="font-size:0.85rem; color:var(--text-sub); margin-top:3px;">Zihinsel toparlanma, haftalık eksik giderme ve hafif genel tekrar günü.</p>
                                </div>
                            </div>
                        </div>
                    `;
                } else {
                    let blocks = [];
                    let currentDayTime = 0;

                    if (m.phase === 'TYT') {
                        let b1 = tytPool[tIndex % tytPool.length]; tIndex++;
                        blocks.push({ id: `${dayKey}-b1`, num: "1. Blok (Sabah)", desc: b1.desc, time: b1.time });
                        currentDayTime += b1.time;

                        let b2 = tytPool[tIndex % tytPool.length]; tIndex++;
                        blocks.push({ id: `${dayKey}-b2`, num: "2. Blok (Öğle)", desc: b2.desc, time: b2.time });
                        currentDayTime += b2.time;

                        blocks.push({ id: `${dayKey}-b3`, num: "3. Blok (Akşam)", desc: "Soru Çözümü - Paragraf, Problem ve Fen Soru Kampı", time: 3.5 });
                        currentDayTime += 3.5;

                    } else if (m.phase === 'AYT') {
                        let b1 = aytPool[aIndex % aytPool.length]; aIndex++;
                        blocks.push({ id: `${dayKey}-b1`, num: "1. Blok (Sabah)", desc: b1.desc, time: b1.time });
                        currentDayTime += b1.time;

                        let b2 = aytPool[aIndex % aytPool.length]; aIndex++;
                        blocks.push({ id: `${dayKey}-b2`, num: "2. Blok (Öğle)", desc: b2.desc, time: b2.time });
                        currentDayTime += b2.time;

                        blocks.push({ id: `${dayKey}-b3`, num: "3. Blok (Akşam)", desc: "AYT Soru Bankası Tarama & TYT Branş Denemesi", time: 3.5 });
                        currentDayTime += 3.5;

                    } else {
                        blocks.push({ id: `${dayKey}-b1`, num: "1. Blok (Sabah)", desc: "Tam TYT / AYT Genel Deneme Sınavı", time: 3.5 });
                        blocks.push({ id: `${dayKey}-b2`, num: "2. Blok (Öğle)", desc: "Deneme Detaylı Yanlış / Boş Analizi & Kök Neden Tespiti", time: 3 });
                        blocks.push({ id: `${dayKey}-b3`, num: "3. Blok (Akşam)", desc: "Nokta Atışı Eksik Konu Tamamlama & Soru Kampı", time: 3.5 });
                        currentDayTime = 10;
                    }

                    html += `
                        <div class="day-card study-card">
                            <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:8px;">
                                <h3>${day} ${m.name}</h3>
                                <span style="color:var(--warning); font-size:0.9rem; font-weight:bold;">Toplam Hedef: ${currentDayTime} Saat</span>
                            </div>
                            <div class="block-list">
                                ${blocks.map(b => {
                                    const isChecked = completedBlocks.includes(b.id);
                                    return `
                                        <div class="block-item ${isChecked ? 'completed' : ''}" id="block-item-${b.id}">
                                            <input type="checkbox" class="block-checkbox" ${isChecked ? 'checked' : ''} onchange="toggleBlockCompletion('${b.id}')">
                                            <div>
                                                <span class="block-tag">${b.num} (${b.time} Saat)</span>
                                                <div class="block-title" style="font-size:0.9rem; font-weight:600;">${b.desc}</div>
                                            </div>
                                        </div>
                                    `;
                                }).join('')}
                            </div>
                        </div>
                    `;
                }
            }
            container.innerHTML = html;
        });
    }

    function switchTab(evt, tabId) {
        document.querySelectorAll('.tab-content').forEach(el => el.classList.remove('active'));
        document.querySelectorAll('.tab-btn').forEach(el => el.classList.remove('active'));
        document.getElementById(tabId).classList.add('active');
        evt.target.classList.add('active');
    }

    function switchSubTab(evt, subId) {
        document.querySelectorAll('.sub-tab-content').forEach(el => el.classList.remove('active'));
        document.querySelectorAll('.sub-tab-btn').forEach(el => el.classList.remove('active'));
        document.getElementById(subId).classList.add('active');
        evt.target.classList.add('active');
    }

    // ZAMANLAYICI MANTIĞI
    let timerId = null;
    let timeLeft = 90 * 60;
    let isWorking = true;

    function toggleTimer() {
        const btn = document.getElementById('timer-btn');
        if (timerId) {
            clearInterval(timerId);
            timerId = null;
            btn.innerText = 'Devam Et';
        } else {
            btn.innerText = 'Duraklat';
            timerId = setInterval(() => {
                if (timeLeft > 0) {
                    timeLeft--;
                    updateTimerDisplay();
                } else {
                    clearInterval(timerId);
                    timerId = null;
                    isWorking = !isWorking;
                    timeLeft = isWorking ? 90 * 60 : 15 * 60;
                    document.getElementById('timer-title').innerText = isWorking ? "Odaklanma Bloğu (90 Dakika)" : "Mola Süresi (15 Dakika)";
                    alert(isWorking ? "Mola bitti! Çalışma bloğuna dön." : "90 dk çalışma bitti! 15 dk mola zamanı.");
                    updateTimerDisplay();
                    btn.innerText = 'Başlat';
                }
            }, 1000);
        }
    }

    function resetTimer() {
        if (timerId) clearInterval(timerId);
        timerId = null;
        isWorking = true;
        timeLeft = 90 * 60;
        document.getElementById('timer-title').innerText = "Odaklanma Bloğu (90 Dakika)";
        document.getElementById('timer-btn').innerText = 'Başlat';
        updateTimerDisplay();
    }

    function updateTimerDisplay() {
        const m = Math.floor(timeLeft / 60).toString().padStart(2, '0');
        const s = (timeLeft % 60).toString().padStart(2, '0');
        document.getElementById('timer-display').innerText = `${m}:${s}`;
    }

    // DENEME ANALİZİ
    function saveAnalysis() {
        const type = document.getElementById('exam-type').value;
        const net = document.getElementById('exam-net').value;
        const reason = document.getElementById('exam-reason').value;

        if (!net) return;

        analyses.unshift({ type, net, reason, date: new Date().toLocaleDateString('tr-TR') });
        localStorage.setItem('yks_multiblock_analyses', JSON.stringify(analyses));
        renderAnalyses();
        document.getElementById('exam-net').value = '';
    }

    function renderAnalyses() {
        const list = document.getElementById('analysis-list');
        list.innerHTML = '';
        analyses.forEach(item => {
            const div = document.createElement('div');
            div.style.background = '#0f172a';
            div.style.padding = '10px';
            div.style.borderRadius = '6px';
            div.style.marginBottom = '8px';
            div.style.border = '1px solid var(--border-color)';
            div.innerHTML = `<strong>${item.type} Denemesi</strong> - <span style="color:#38bdf8">${item.net} Net</span><br><small style="color:var(--warning)">Kök Neden: ${item.reason} (${item.date})</small>`;
            list.appendChild(div);
        });
    }
</script>
</body>
</html>
